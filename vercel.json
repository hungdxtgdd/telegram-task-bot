{
  "version": 2,
  "builds": [
    {
      "src": "api/bot.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/users-enhanced.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/update-database.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/optimize-database.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/health.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/projects-enhanced.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/tasks-enhanced.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/okrs-enhanced.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/auth-endpoint.js",
      "use": "@vercel/node"
    },
    {
      "src": "pages/login.html",
      "use": "@vercel/static"
    },
    {
      "src": "pages/projects-enhanced.html",
      "use": "@vercel/static"
    },
    {
      "src": "pages/tasks-enhanced.html",
      "use": "@vercel/static"
    },
    {
      "src": "pages/okrs-enhanced.html",
      "use": "@vercel/static"
    },
    {
      "src": "pages/users-management.html",
      "use": "@vercel/static"
    },
    {
      "src": "pages/dashboard-enhanced.html",
      "use": "@vercel/static"
    },
    {
      "src": "pages/monitoring.html",
      "use": "@vercel/static"
    },
    {
      "src": "pages/test-auth.html",
      "use": "@vercel/static"
    },
    {
      "src": "pages/test-dashboard.html",
      "use": "@vercel/static"
    },
    {
      "src": "pages/test-simple-dashboard.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/login",
      "dest": "/pages/login.html"
    },
    {
      "src": "/dashboard",
      "dest": "/pages/dashboard-enhanced.html"
    },
    {
      "src": "/monitoring",
      "dest": "/pages/monitoring.html"
    },
        {
          "src": "/test-auth",
          "dest": "/pages/test-auth.html"
        },
    {
      "src": "/test-dashboard",
      "dest": "/pages/test-dashboard.html"
    },
    {
      "src": "/test-simple-dashboard",
      "dest": "/pages/test-simple-dashboard.html"
    },
    {
      "src": "/projects",
      "dest": "/pages/projects-enhanced.html"
    },
    {
      "src": "/tasks",
      "dest": "/pages/tasks-enhanced.html"
    },
    {
      "src": "/okrs",
      "dest": "/pages/okrs-enhanced.html"
    },
    {
      "src": "/admin-users",
      "dest": "/pages/users-management.html"
    },
    {
      "src": "/test-user",
      "dest": "/pages/test-user.html"
    },
    {
      "src": "/",
      "dest": "/pages/projects-enhanced.html"
    },
    {
      "src": "/api/bot",
      "dest": "/api/bot.js"
    },
    {
      "src": "/api/users-enhanced",
      "dest": "/api/users-enhanced.js"
    },
    {
      "src": "/api/users-enhanced/",
      "dest": "/api/users-enhanced.js"
    },
    {
      "src": "/api/users-enhanced/(.*)",
      "dest": "/api/users-enhanced.js"
    },
    {
      "src": "/api/update-database",
      "dest": "/api/update-database.js"
    },
    {
      "src": "/api/optimize-database",
      "dest": "/api/optimize-database.js"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/projects-enhanced",
      "dest": "/api/projects-enhanced.js"
    },
    {
      "src": "/api/projects-enhanced/",
      "dest": "/api/projects-enhanced.js"
    },
    {
      "src": "/api/projects-enhanced/(.*)",
      "dest": "/api/projects-enhanced.js"
    },
    {
      "src": "/api/tasks-enhanced",
      "dest": "/api/tasks-enhanced.js"
    },
    {
      "src": "/api/tasks-enhanced/",
      "dest": "/api/tasks-enhanced.js"
    },
    {
      "src": "/api/tasks-enhanced/(.*)",
      "dest": "/api/tasks-enhanced.js"
    },
    {
      "src": "/api/okrs-enhanced",
      "dest": "/api/okrs-enhanced.js"
    },
    {
      "src": "/api/okrs-enhanced/",
      "dest": "/api/okrs-enhanced.js"
    },
    {
      "src": "/api/okrs-enhanced/(.*)",
      "dest": "/api/okrs-enhanced.js"
    },
    {
      "src": "/api/auth",
      "dest": "/api/auth-endpoint.js"
    },
    {
      "src": "/api/auth/",
      "dest": "/api/auth-endpoint.js"
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/auth-endpoint.js"
    },
    {
      "src": "/webhook",
      "dest": "/api/bot.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}