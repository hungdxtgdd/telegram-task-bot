{
  "version": 2,
  "builds": [
    {
      "src": "api/bot.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/tasks.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/users.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/auth-endpoint.js",
      "use": "@vercel/node"
    },
    {
      "src": "pages/dashboard.html",
      "use": "@vercel/static"
    },
    {
      "src": "pages/login.html",
      "use": "@vercel/static"
    },
    {
      "src": "pages/users.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/bot",
      "dest": "/api/bot.js"
    },
    {
      "src": "/api/tasks",
      "dest": "/api/tasks.js"
    },
    {
      "src": "/api/users/(.*)",
      "dest": "/api/users.js"
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/auth-endpoint.js"
    },
    {
      "src": "/webhook",
      "dest": "/api/bot.js"
    },
    {
      "src": "/login",
      "dest": "/pages/login.html"
    },
    {
      "src": "/users",
      "dest": "/pages/users.html"
    },
    {
      "src": "/dashboard",
      "dest": "/pages/dashboard.html"
    },
    {
      "src": "/",
      "dest": "/pages/login.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
