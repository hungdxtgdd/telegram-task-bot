# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_URL=https://your-app.vercel.app/webhook

# Database Configuration (Vercel Postgres)
DATABASE_URL=postgresql://username:password@host:port/database

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here

# Bot Configuration
BOT_USERNAME=@your_bot_username
BOT_LINK=https://t.me/your_bot_username

# WebSocket Configuration (for real-time features)
WS_URL=wss://your-websocket-server.com/ws

# Google Drive Configuration (for file attachments)
GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key

# Environment
NODE_ENV=production

# CORS Configuration
CORS_ORIGIN=https://your-app.vercel.app

# Backup Configuration
BACKUP_SCHEDULE=0 0 * * *  # Daily at midnight
BACKUP_RETENTION_DAYS=30